version: 2
updates:
  - package-ecosystem: npm
    directory: /
    schedule:
      interval: weekly
    open-pull-requests-limit: 5
    labels: [dependencies, javascript]
    groups:
      opentelemetry:
        patterns: ['@opentelemetry/*']

  - package-ecosystem: github-actions
    directory: /
    schedule:
      interval: weekly
    open-pull-requests-limit: 5
    labels: [dependencies, github-actions]

# DISABLED (as in platform-gincommon) — GitHub only reads .github/dependabot.yml, so this renamed
# file stops scheduled version-update checks without losing the configuration. Note: @opentelemetry/api
# must stay in ~1.10 (the shared-module range, design doc §C3) and react in the platformShared range.
#
# Re-enable:  git mv .github/dependabot.yml.disabled .github/dependabot.yml
