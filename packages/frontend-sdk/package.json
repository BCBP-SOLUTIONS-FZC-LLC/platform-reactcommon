{
  "name": "@platform/frontend-sdk",
  "version": "1.0.0-alpha.0",
  "description": "Shared TypeScript SDK for React micro-frontends: contract-compatible with platform-gincommon and platform-fastapicommon.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "contracts"
  ],
  "exports": {
    ".": {
      "types": "./dist/root.d.ts",
      "import": "./dist/root.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./problem": {
      "types": "./dist/problem/index.d.ts",
      "import": "./dist/problem/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js"
    },
    "./tracing": {
      "types": "./dist/tracing/index.d.ts",
      "import": "./dist/tracing/index.js"
    },
    "./logging": {
      "types": "./dist/logging/index.d.ts",
      "import": "./dist/logging/index.js"
    },
    "./metrics": {
      "types": "./dist/metrics/index.d.ts",
      "import": "./dist/metrics/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "api": "tsx ../../scripts/api-report.ts",
    "api:check": "tsx ../../scripts/api-report.ts --check"
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1.10.0 <1.11.0",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "restricted"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.10.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "dependencies": {
    "@opentelemetry/core": "^3.0.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.300.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/otlp-transformer": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-logs": "^3.0.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "zod": "^4.6.7"
  }
}
