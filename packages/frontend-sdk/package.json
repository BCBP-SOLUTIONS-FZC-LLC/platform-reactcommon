{
  "name": "@platform/frontend-sdk",
  "version": "1.0.0-alpha.0",
  "description": "Shared TypeScript SDK for React micro-frontends: contract-compatible with platform-gincommon and platform-fastapicommon.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "contracts"
  ],
  "exports": {
    ".": {
      "types": "./dist/root.d.ts",
      "import": "./dist/root.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./problem": {
      "types": "./dist/problem/index.d.ts",
      "import": "./dist/problem/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "api": "tsx ../../scripts/api-report.ts",
    "api:check": "tsx ../../scripts/api-report.ts --check"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "restricted"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.10.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
